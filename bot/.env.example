# Telegram bot token from @BotFather (fake value below)
BOT_TOKEN=123456789:AAFakeTokenReplaceMe_xxxxxxxxxxxxxxxx
# FastAPI backend base URL
BACKEND_URL=http://127.0.0.1:8000/api/v1
# true (default): the bot answers everyone (jury, any private chat or group)
PUBLIC_MODE=true
# Used only when PUBLIC_MODE=false: comma-separated chat ids (group ids start with -100...)
ALLOWED_CHAT_IDS=
# Per-user limits and the global cap on simultaneous agent questions
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=200
AGENT_CONCURRENCY=20
AGENT_TIMEOUT=80
EXPORT_MAX_ROWS=20000
