# Birja reyestri backend - copy to .env (never commit .env).
APP_NAME=Birja Reyestri API
APP_ENV=development
DEBUG=false
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

HOST=127.0.0.1
PORT=8000

# Default: local SQLite (WAL). PostgreSQL also works:
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/birja
DATABASE_URL=sqlite+aiosqlite:///./birja.db
AI_READ_DATABASE_URL=

# Empty = in-memory cache. Example: redis://localhost:6379/0
REDIS_URL=

# Security: generate with  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER=X-API-Key

# Rate limits (requests / minute / client)
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=20
RATE_LIMIT_AI=30
RATE_LIMIT_EXPORT=10

# AI (mock works offline). Keys stay empty here.
AI_PROVIDER=mock
AI_MODEL=uzex-ai-mock
OPENAI_API_KEY=
GEMINI_API_KEY=
# AI_PROVIDER=gemini  AI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=uzex-ai

ADMIN_EMAIL=admin@birja.local
ADMIN_PASSWORD=replace-with-strong-password

# CSV import / export
IMPORT_BATCH_SIZE=5000
DATA_DIR=../data
EXPORT_MAX_ROWS=500000
CACHE_TTL_SECONDS=600
